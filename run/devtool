#!/bin/bash

RUN_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
PROJ_DIR=$(cd $RUN_DIR && cd .. && pwd)

print_useage() {
    cat << \EOF
Useage: devtool COMMAND [OPTIONS]

Commands:
    build           Build project
    test            Run unit test
    gendoc          Regenerate document

Options:
    -d, --debug     Build in debug mode.
    -n              Number of process to run.
    -c, --coverage  Produce coverage report. This option will also turn on debug build.
    --grep=<regex>  Run tests matching given regular expression.
    -v, --verbose   Enable verbose output from tests.
    -b, --browser   Open browser to view coverage report or documents.
    -h, --help      Print this message.

EOF
}

if [ $# -lt 1 ]; then
    print_useage
    exit 1
fi

if ! TEMP=`getopt -n "devtool" -o bcdhn:v --long browser,coverage,debug,grep:,help,verbose -- "$@"`;
then
    exit 1
fi
eval set -- "$TEMP"

BUILD_TYPE=Release
while true; do
    case "$1" in
        -b|--browser)
            OPEN_BROWSER=true;;
        -c|--coverage)
            BUILD_TYPE=Debug; RUN_COVERAGE=true;;
        -d|--debug)
            BUILD_TYPE=Debug;;
        -h|--help)
            print_useage; exit 0;;
        -n)
            MPI_RUN="mpirun -n $2"; shift;;
        -v|--verbose)
            VERBOSE=--verbose;;
        --grep)
            GREP="-R $2"; shift;;
        --)
            shift; break;;
        *)
            echo "$0: error -- Unrecognized options $1"; print_useage; exit 1;;
    esac
    shift
done

build() {
    mkdir -p $PROJ_DIR/build/$BUILD_TYPE
    cd $PROJ_DIR/build/$BUILD_TYPE
    cmake . $PROJ_DIR/src -DCMAKE_BUILD_TYPE=$BUILD_TYPE && make -j
}

case $1 in
    build)
        build;;
    test)
        build; cd $PROJ_DIR/build/$BUILD_TYPE/tests; $MPI_RUN ctest $GREP $VERBOSE;
        if [ "$RUN_COVERAGE" = true ] ; then
            GCOVR_FILTERS="-r $PROJ_DIR -f $PROJ_DIR/src/libs
                          --exclude-directories '$PROJ_DIR/build/Release$'"
            gcovr $GCOVR_FILTERS && gcovr $GCOVR_FILTERS -b -s
            mkdir -p $PROJ_DIR/documents/coverage
            URL=$PROJ_DIR/documents/coverage/coverage.html
            gcovr $GCOVR_FILTERS --html --html-details -o $URL
        fi;;
    gendoc)
        cd $PROJ_DIR/documents
        doxygen Doxyfile
        URL=$PROJ_DIR/documents/doxygen/html/index.html
    ;;
    *)
        print_useage
        exit 1
    ;;
esac

if [ "$OPEN_BROWSER" = true ]; then
    sensible-browser $URL
fi
